{
    "name": "studio-panel",
    "version": "2.1.0",
    "private": true,
    "description": "White-label staff panel for Roblox studios: sign-in with Roblox or Google, roles, work logging, approvals, payouts, teams and recruitment.",
    "main": "server.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node scripts/start.js",
        "start:api": "node server.js",
        "start:bot": "node bot.js",
        "check": "node --check server.js && node --check bot.js && node scripts/check-config.js",
        "stamp": "node scripts/build-manifest.js && node scripts/stamp-assets.js",
        "test": "node --test test/*.test.js",
        "release": "node scripts/release.js",
        "license:demo": "node scripts/license.js demo"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "compression": "^1.7.5",
        "cors": "^2.8.5",
        "discord.js": "^14.27.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "web-push": "^3.6.7"
    }
}
