# ---------------------------------------------------------------------------
# API server (server.js) and Discord bot (bot.js) settings.
# Copy to .env for local development; set these as environment variables on your host.
# Run `npm run check` to validate.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Where the web app is served from (no trailing slash). Only this origin may call the API.
APP_ORIGIN=https://hub.yourstudio.com
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://api.yourstudio.com/roblox-auth-callback

# Strongly recommended -------------------------------------------------------
# Long random string used to sign short-lived tickets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# API key for Roblox group management (group membership checks / ranks).
ROBLOX_GROUP_API_KEY=

# Discord (optional: recruitment, DMs, ticket channels, the bot) -------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.yourstudio.com/discord-auth-callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LEAD_CHANNEL_ID=
DISCORD_HR_ROLE_IDS=
# These two can also live in studio.config.json under "discord".
DISCORD_LEAD_ROLE_ID=
DISCORD_TICKET_CATEGORY_ID=

# Browser push notifications (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@yourstudio.com

# Branding overrides (optional; studio.config.json is the usual place) -------
# STUDIO_NAME=Your Studio
# STUDIO_SHORT_NAME=YS
# STUDIO_WEBSITE=https://yourstudio.com
# STUDIO_LOGO_URL=https://yourstudio.com/logo.png
# STUDIO_REQUEST_PREFIX=YS
# Comma-separated features to switch off, e.g. recruitment,paymentRuns
# STUDIO_DISABLED_FEATURES=

# Money safety rails (optional) -------------------------------------------
# Let people approve/pay their own requests. Leave false unless you are a one-person studio.
# ALLOW_SELF_APPROVAL=false
# MAX_ROBUX_PER_REQUEST=10000000
# MAX_USD_PER_REQUEST=100000

# Networking / limits (optional) -------------------------------------------
# PORT=3000
# Extra allowed browser origins, comma-separated (e.g. a staging site).
# EXTRA_ORIGINS=
# Number of proxy hops in front of the API (Render/Cloudflare = 1).
# TRUST_PROXY=1
# RATE_LIMIT_PER_MIN=600
# RATE_LIMIT_SESSION_PER_MIN=240
