# ---------------------------------------------------------------------------
# API server (server.js) and Discord bot (bot.js) settings.
# Copy to .env for local development; set these as environment variables on your host.
# Run `npm run check` to validate.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Where the web app is served from (no trailing slash). Only this origin may call the API.
APP_ORIGIN=https://hub.yourstudio.com
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Roblox OAuth app (create.roblox.com/credentials). Only required when AUTH_PROVIDERS
# includes roblox.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://api.yourstudio.com/roblox-auth-callback

# Licence -------------------------------------------------------------------
# The licence key you were given (see SETUP.md > Licences). Without one a licensed build runs
# as Core. Discord also needs ADDON_DISCORD=true.
LICENSE_KEY=

# Sign-in ------------------------------------------------------------------
# Which sign-in buttons to show: roblox, google, test (comma-separated).
#   test = one-click Owner / Manager / Staff test accounts. For demos and QA only.
AUTH_PROVIDERS=roblox
# Who gets the "Owner" role automatically when they sign in. Set at least one of these
# on a fresh database, otherwise nobody can get in to set things up.
OWNER_ROBLOX_IDS=
OWNER_EMAILS=

# Google sign-in (only if AUTH_PROVIDERS includes google).
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourstudio.com/google-auth-callback
# Let anyone with an email on these domains in (e.g. your Google Workspace domain).
GOOGLE_ALLOWED_DOMAINS=

# Strongly recommended -------------------------------------------------------
# Long random string used to sign short-lived tickets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# API key for Roblox group management (group membership checks / ranks).
ROBLOX_GROUP_API_KEY=

# Discord add-on (paid extra, OFF by default) ----------------------------------
# Discord account linking, Discord sign-in servers, Discord roles, the bot and Recruitment.
# While ADDON_DISCORD is not true, everything below is ignored and none of it shows in the
# panel. Only switch it on for a deployment that has bought the add-on.
ADDON_DISCORD=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.yourstudio.com/discord-auth-callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LEAD_CHANNEL_ID=
DISCORD_HR_ROLE_IDS=
DISCORD_LEAD_ROLE_ID=
DISCORD_TICKET_CATEGORY_ID=

# Browser push notifications for applicants (Discord add-on only).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@yourstudio.com

# Branding overrides (optional) ----------------------------------------------
# The usual place for branding is Settings > Branding inside the panel. studio.config.json
# sets the defaults; these variables override the file (and are overridden by the panel).
# STUDIO_NAME=Your Studio
# STUDIO_SHORT_NAME=YS
# STUDIO_WEBSITE=https://yourstudio.com
# STUDIO_LOGO_URL=https://yourstudio.com/logo.png
# STUDIO_REQUEST_PREFIX=YS
# Comma-separated features to switch off, e.g. recruitment,paymentRuns
# STUDIO_DISABLED_FEATURES=

# Money safety rails (optional) -------------------------------------------
# Let people approve/pay their own requests. Leave false unless you are a one-person studio.
# ALLOW_SELF_APPROVAL=false
# MAX_ROBUX_PER_REQUEST=10000000
# MAX_USD_PER_REQUEST=100000

# Networking / limits (optional) -------------------------------------------
# Timeout for calls to Roblox / Discord / Google / Supabase, in milliseconds.
# OUTBOUND_TIMEOUT_MS=25000

# Operations (optional) -----------------------------------------------------
# Where to send alerts (new errors, missed backups): a Discord or Slack incoming webhook URL.
# Leave empty to use the studio webhook from Settings > Notifications instead.
# ALERT_WEBHOOK_URL=
# BACKUP_RETENTION_DAYS=30
# BACKUP_KEEP_MIN=10
# BACKUP_STALE_HOURS=14
# PORT=3000
# Extra allowed browser origins, comma-separated (e.g. a staging site).
# EXTRA_ORIGINS=
# Number of proxy hops in front of the API (Render/Cloudflare = 1).
# TRUST_PROXY=1
# RATE_LIMIT_PER_MIN=600
# RATE_LIMIT_SESSION_PER_MIN=240
# RATE_LIMIT_PUBLIC_PER_MIN=120
